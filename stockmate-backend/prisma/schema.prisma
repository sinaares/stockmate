generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int                 @id @default(autoincrement())
  name       String
  email      String              @unique
  password   String
  role       String
  active     Int                 @default(1)
  createdAt  DateTime            @default(now()) @map("created_at")
  
  requestsSubmitted  Request[]           @relation("EmployeeRequests")
  requestsResolved   Request[]           @relation("ResolvedRequests")
  transactions       Transaction[]
  technicalServices  TechnicalService[]

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  nameTr   String    @map("name_tr")
  nameEn   String    @map("name_en")
  products Product[]

  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  barcode     String?       @unique
  serialKey   String?       @unique @map("serial_key")
  categoryId  Int?          @map("category_id")
  category    Category?     @relation(fields: [categoryId], references: [id])
  quantity    Int           @default(0)
  unit        String        @default("adet")
  price       Decimal       @default(0) @db.Decimal(12, 2)
  description String?
  minStock    Int           @default(5) @map("min_stock")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  requests     Request[]
  transactions Transaction[]

  @@map("products")
}

model Request {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  employee     User      @relation("EmployeeRequests", fields: [employeeId], references: [id])
  productId    Int       @map("product_id")
  product      Product   @relation(fields: [productId], references: [id])
  actionType   String    @map("action_type")
  quantity     Int
  note         String?
  status       String    @default("pending")
  rejectReason String?   @map("reject_reason")
  resolvedBy   Int?      @map("resolved_by")
  resolver     User?     @relation("ResolvedRequests", fields: [resolvedBy], references: [id])
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("requests")
}

model Transaction {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  product        Product   @relation(fields: [productId], references: [id])
  userId         Int       @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  actionType     String    @map("action_type")
  quantity       Int
  quantityBefore Int       @map("quantity_before")
  quantityAfter  Int       @map("quantity_after")
  note           String?
  requestId      Int?      @map("request_id")
  request        Request?  @relation(fields: [requestId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("transactions")
}

model TechnicalService {
  id               Int       @id @default(autoincrement())
  customerName     String    @map("customer_name")
  customerPhone    String?   @map("customer_phone")
  deviceType       String    @map("device_type")
  deviceBrand      String    @map("device_brand")
  deviceModel      String?   @map("device_model")
  serialNo         String?   @map("serial_no")
  faultDescription String    @map("fault_description")
  partsToReplace   String?   @map("parts_to_replace")
  technicianId     Int?      @map("technician_id")
  technician       User?     @relation(fields: [technicianId], references: [id])
  status           String    @default("waiting")
  note             String?
  price            Decimal   @default(0) @db.Decimal(12, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("technical_services")
}
