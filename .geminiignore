# ==============================================================================
# .geminiignore - StockMate Project
# ==============================================================================

# Node.js & Backend dependencies
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment & Secret files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore

# Flutter & Dart dependencies and build outputs
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
**/build/

# Android build outputs & local config
**/android/.gradle/
**/android/app/build/
**/android/local.properties
**/android/key.properties
**/android/captures/

# iOS build outputs & Pods
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/

# Windows/Desktop ephemeral
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# Large media & screen captures
*.png
*.jpg
*.jpeg
*.mp4
*.zip
*.tar.gz

# IDE & OS caches
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
